{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "sources": "https://github.com/BMProjects-Development/BMP-Quests"
  },
  "license": "${license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "org.bmp.bmp_quests.BMPQuests"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json",
    "${mod_id}.fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "ftbquests": "=${ftb_quests_version}",
    "ftblibrary": ">=${ftb_library_version}",
    "architectury": ">=${architectury_version}"
  }
}
